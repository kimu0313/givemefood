{
  "name": "pocha-tycoon",
  "private": true,
  "version": "0.1.0",
  "description": "포장마차 타이쿤 — 비 오는 밤 포장마차를 운영하는 2D 조리 타이쿤 (JS/TypeScript + Canvas 버전)",
  "type": "module",
  "scripts": {
